mov %9980,0
csp 989


dwave 1,"sound\se-tettai.wav"

gosub *keion_kaimetu_11

 gosub *vn_text_000037 

csp 1 : csp 2 : csp 3 : csp 4 : csp 5 : csp 6 : csp 205 : csp 245

mov %nakama_senhuka_02,1

return



