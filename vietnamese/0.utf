*vn_bclear
for %9999=0 to 255
mov ?9999[%9999],0
next
return

*vn_bsp
getparam %9999,$9999,$9998,$9997
mov ?9999[%9999],1
mov %9996,9000+%9999*3
mov $%9996,$9999
add %9996,1
mov $%9996,$9998
add %9996,1
mov $%9996,$9997
return

*vn_bexec
getparam s%9987
btndef clear
mov $9986,""
for %9999=0 to 255
if ?9999[%9999]=1 gosub *vn_register_button
next
exbtn_d $9986
btnwait %9988
if %9988=-1 : mov $%9987,"R" : return
if %9988<=0 : mov $%9987,"" : return
itoa $9989,%9988
mov $%9987,"S"+$9989
dwave 1,"sound\se-on01.wav"
return

*vn_register_button
mov %9996,9000+%9999*3
mov $9986,$9986+$%9996
add %9996,1
spbtn %9999,%9999
exbtn %9999,%9999,$%9996
return

*vn_saveload_menu
systemcall rmenu
return

*vn_wrap_guard
getcursorpos %9982,%9983
; Reserve an upcoming newline plus glyph ascent/descent and shadow.
; The old 680 boundary let an inherited row wrap to y=716 and update
; beyond the 720px texture before the next guard could run.
if %9983>640 gosub *vn_wrap_page
return

*vn_wrap_page
^\
return

*vn_auto_target
mov %1,0
if %bu01_hp<1 mov %9980,0 : return
gosub *vn_auto_poll
if %9980=0 return
if %tekihei_01>0 mov %1,201 : return
if %tekihei_02>0 mov %1,202 : return
if %tekihei_03>0 mov %1,203 : return
if %tekihei_04>0 mov %1,204 : return
return

*vn_auto_textwait
if %9980=1 && %sentou_on=1 gosub *vn_auto_poll : mov %0,0 : return
textbtnwait %0
return

*vn_auto_poll
btntime 120
btnwait2 %9978
btntime 0
if %9978=-1 mov %9980,0
if %9978=989 mov %9980,0
return

*vn_mode_ui_clear
mov %9980,0
csp 989
vsp 989,0
prnumclear
barclear
textclear
textoff
btndef clear
return

