*onna_serihu_naka_01

if %onna_01 = 1 : mov $81,":s/14,14,0,2;#FFFFFF^"+"Hể~ Vậy ạ? Tuyệt thật đấy."
if %onna_02 = 1 : mov $81,":s/14,14,0,2;#FFFFFF^"+"Ly này em mời. Uống một hơi hết luôn nào! Một hơi hết luôn!"
if %onna_03 = 1 : mov $81,":s/14,14,0,2;#FFFFFF^"+"A ha ha, buồn cười quá~ Quý khách nói chuyện khéo thật đấy♪"
if %onna_04 = 1 : mov $81,":s/14,14,0,2;#FFFFFF^"+"Hửm? Nhiều đá quá ạ? Em xin lỗi vì sự sơ suất này..."
if %onna_05 = 1 && %ibe_baniikan_sai = 0 : mov $81,":s/14,14,0,2;#FFFFFF^"+"Anh thích kiểu con gái xưng tôi à? Ehehe, vậy thì cảm ơn anh nhé"
