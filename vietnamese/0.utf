if %banii_kinka_03 = 200 && %banii_hugou_ban = 3 : mov $73,":s/14,14,0,2;#FFFFFF^"+"Lần tới tôi hy vọng sẽ gặp được một cô bé phù hợp với yêu cầu của mình hơn"
if %banii_kinka_04 = 200 && %banii_hugou_ban = 4 : mov $74,":s/14,14,0,2;#FFFFFF^"+"Lần tới tôi hy vọng sẽ gặp được một cô bé phù hợp với yêu cầu của mình hơn"
