; ▼ダーン＝ジョー【毒絶地獄】
;――――――――――――――――――――――

*teki_keiryaku_in_dokuzetu

dwave 1,"sound\se-hatudou.wav"

 gosub *vn_text_016395 

dwave 1,"sound\se-mera.wav"

 gosub *vn_text_016396 
wait 600
 gosub *vn_text_016397 

mov %dame_on,240

gosub *dame_zunou


mov %doku_on,1

lsp 555,":a/3,<4000,100,100>,2;at\at-eye_00_09.png",980,166;――▼立ち絵
print 1

 gosub *vn_text_016398 


sub %teki_sikido,3




goto *teki_coma02



;――――――――――――――――――――――
; ▼ダーン＝ジョー【茶の極み】
;――――――――――――――――――――――

*teki_keiryaku_in_tyano

dwave 1,"sound\se-hatudou.wav"

 gosub *vn_text_016399 

dwave 1,"sound\se-kaihuku.wav"


add %tekihei_01,500
mov %ko01,500

gosub *suuji_gazou_dasu_01e
gosub *keion_kaihuku

if %syoki_tekihei_01 < %tekihei_01 : mov %tekihei_01,%syoki_tekihei_01

bar 11,%tekihei_01,210,40,180,5,%syoki_tekihei_01,#FF0066


 gosub *vn_text_016400 
wait 600
 gosub *vn_text_016401 

csp 1 : csp 2 : csp 3 : csp 4

sub %teki_sikido,3

goto *teki_coma01











