*onna_serihu_ato_001


if %onna_01 = 1 : mov $81,":s/14,14,0,2;#FFFFFF^"+"Nhiều tiền thế này sao!? Tôi xin cảm ơn!"
if %onna_02 = 1 : mov $81,":s/14,14,0,2;#FFFFFF^"+"Tôi thích quý khách rồi đấy. Lần tới cũng xin hãy hào phóng như vậy nhé~"
if %onna_03 = 1 : mov $81,":s/14,14,0,2;#FFFFFF^"+"Viola đã rất vui. Cảm ơn vì bữa tiệc nhé~♪"
if %onna_04 = 1 : mov $81,":s/14,14,0,2;#FFFFFF^"+"Cảm ơn anh vì đã uống nhiều như vậy. Tôi rất vui."
if %onna_05 = 1 && %ibe_baniikan_sai = 0 : mov $81,":s/14,14,0,2;#FFFFFF^"+"Công việc tiếp khách thú vị thật đấy! Tôi cũng thấy rất vui."
if %onna_05 = 1 && %ibe_baniikan_sai = 1 : mov $81,":s/14,14,0,2;#FFFFFF^"+"Nếu muốn uống thêm thì hãy đến tiệm Rinmei nhé~"
if %onna_06 = 1 : mov $81,":s/14,14,0,2;#FFFFFF^"+"Vì quý khách đã uống nhiều như vậy nên tôi cũng rất vui"

