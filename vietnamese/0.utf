;――――――――――――――――――――――
; ▼システムカスタマイズ
;――――――――――――――――――――――

*custom

erasetextwindow 0
ispage %499

*custom_btn

btndef clear
spbtn 24,100
spbtn 25,101
;スプライト24番は「SAVE」ボタン、25番は「LOAD」ボタン

;――――――――――――――――――――――▼仮　セーブ　４５
if %master_on = 1 : strsp 44,"Lưu",1120,700,4,1,15,15,0,0,1,0,#FFFF33
if %master_on = 1 : strsp 45,"Tải",1200,700,4,1,15,15,0,0,1,0,#FFFF33
if %master_on = 1 : spbtn 44,1
if %master_on = 1 : spbtn 45,2
;――――――――――――――――――――――

gosub *vn_auto_textwait
repaint

if %0=0  goto *textgo;　左クリック
if %0=-1 goto *textgo;　右クリック

if %0=-2 systemcall lookback;　上ホイール　バックログ表示へ
if %0=-3 goto *textgo;　下ホイール

if %0==100 systemcall save: goto *custom_btn
if %0==101 systemcall load: goto *custom_btn

;――――――――――――――――――――――▼仮　セーブ　４５
if %0=1 savegame 45
savefileexist %2,45
if %0=2 && %2=1 loadgame 45
;――――――――――――――――――――――

*textgo

texec
saveon

return


;――――――――――――
; ▼選択肢カスタマイズ
;――――――――――――

*customsel
selectcolor #FFFF00,#FFFFFF

skipoff
mov %499,2
erasetextwindow 0

*csel_btn

getcselnum %0
getcursorpos %1,%2
if %2+%0*32>700 gosub *vn_wrap_page
getcursorpos %1,%2
if %2+%0*32>700 mov %2,700-%0*32

btndef clear
spbtn 24,100
spbtn 25,101

cselbtn 0,50,%1,%2
add %2,32
cselbtn 1,51,%1,%2
if %0>2 add %2,32 : cselbtn 2,52,%1,%2
if %0>3 add %2,32 : cselbtn 3,53,%1,%2
if %0>4 add %2,32 : cselbtn 4,54,%1,%2

print 1
selectbtnwait %0
repaint

if %0<=0 skip -5
if %0==100 systemcall save: goto *csel_btn
if %0==101 systemcall load: goto *csel_btn
if %0>=50 && %0<=54 saveon : sub %0,50 : csp 35 : print 1 : erasetextwindow 0 : cselgoto %0



;――――――――――――――――――――――
; ▼章はじめ　画像
