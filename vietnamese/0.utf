;modew720,value1900
;gameid renalith-vietnamese
;localsave saves-vietnamese
*define
h_mapfont 0,"vietnamese/font.ttf"
h_mapfont 1,"vietnamese/font.ttf"
h_mapfont 2,"vietnamese/font.ttf"
h_mapfont 3,"vietnamese/font.ttf"
h_mapfont 4,"vietnamese/font.ttf"
h_mapfont 5,"vietnamese/font.ttf"
h_mapfont 6,"vietnamese/font.ttf"
h_mapfont 7,"vietnamese/font.ttf"
savenumber 30
menusetwindow 18,18,0,-6,0,1,#333333
defsub vn_bclear
defsub vn_bsp
defsub vn_bexec
dim ?9999[255]

nsa
globalon
transmode alpha
humanz 1
defaultspeed 50,20,0
effectcut
savedir "."
 wait 0 
windowback
usewheel
 wait 0 
 wait 0 


effect 2,10,100
effect 3,10,300
effect 4,10,900
effect 5,10,1500;　もっとゆっくりと背景表示
effect 13,10,800;　スタッフロール

 wait 0 ;　はもハート



