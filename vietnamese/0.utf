mov $71,":s/14,14,0,2;#FFFFFF^"+"Tôi rất vui vì được trò chuyện với một cô bé dễ thương như thế này"

mov $72,":s/14,14,0,2;#FFFFFF^"+"Tôi đã có một khoảng thời gian vô cùng tuyệt vời"

mov $73,":s/14,14,0,2;#FFFFFF^"+"Tuyệt lắm, tôi sẽ còn quay lại, mong được giúp đỡ nhé"

mov $74,":s/14,14,0,2;#FFFFFF^"+"Cảm ơn nhé, mọi mệt mỏi trong công việc đều tan biến hết rồi"

mov $75,":s/14,14,0,2;#FFFFFF^"+"Thời gian vui vẻ trôi qua nhanh thật đấy"

mov $76,":s/14,14,0,2;#FFFFFF^"+"Uống nhiều quá rồi... lo cho túi tiền quá..."



if %banii_kinka_01 = 200 : mov $71,":s/14,14,0,2;#FFFFFF^"+"Lần tới đến, tôi sẽ yêu cầu một cô bé đúng gu mình hơn một chút"

if %banii_kinka_02 = 200 : mov $72,":s/14,14,0,2;#FFFFFF^"+"Tôi sẽ quay lại, lần tới hãy sắp xếp bunny girl mà tôi thích nhé"

if %banii_kinka_03 = 200 : mov $73,":s/14,14,0,2;#FFFFFF^"+"Ừm... có vẻ không hợp gu mình cho lắm..."

if %banii_kinka_04 = 200 : mov $74,":s/14,14,0,2;#FFFFFF^"+"Vì không đúng gu nên tôi không thấy vui lắm"

if %banii_kinka_05 = 200 : mov $75,":s/14,14,0,2;#FFFFFF^"+"Vui thì có vui, nhưng lần tới tôi yêu cầu bunny girl đúng gu nhé"

if %banii_kinka_06 = 200 : mov $76,":s/14,14,0,2;#FFFFFF^"+"Chà... đúng là không hợp nhau chút nào"



