*syou_naosi

stop
barclear
csp -1
textoff
btndef ""
bg "image\bg-001.jpg",3
systemcall windowerase
dwave 1,"sound\se-a_story.wav"
bg "bb\bg-001e.jpg",3
wait 1000
bg "bb\bg-001.jpg",3

return



