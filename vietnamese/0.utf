;――――――――――――――――――――――
; ▼敵の戦技時　レナリス　ダメージ
;――――――――――――――――――――――

*teki_kou_sengi_01

;――――――――――――攻撃ダメージ 画像数字

if %cpoint_teki = 70 : mov %cpoint_teki,0

gosub *sentou_tatie_03
gosub *suuji_gazou_dasu_01
gosub *keion_kougeki

;――――――――――――バーの減量

mov %xtekihei_01,%bu01_hp
sub %xtekihei_01,%ko01

for %bu01_hp = %bu01_hp to %xtekihei_01 step -1
if %ji_hp < 20 : bar 1,%bu01_hp,970,10,300,5,%bu01_max,#FF0066
wait 1
print 1
if %bu01_hp < 0 : break
next

;――――――――――――

mov %bu01_hp,%xtekihei_01

gosub *suuji_prnum

if %bu01_hp < 20 : bar 1,%bu01_hp,970,10,300,5,%ji_max,#FF0066

dwave 1,"sound\se-z09.wav"

 gosub *vn_text_000035 



if %bu01_hp < 1 goto *sibou_01x;――――▼敵の戦技の再起

csp 1 : csp 2 : csp 3 : csp 4 : csp 5 : csp 6


;――――――――――――

return



;――――――――――――――――――――――
; ▼敵の戦技時　仲間　ダメージ
;――――――――――――――――――――――

*teki_kou_sengi_02

;――――――――――――攻撃ダメージ 画像数字

if %cpoint_teki = 70 : mov %cpoint_teki,0

lsp 6,":a;image\ih-001.png",600,320

gosub *suuji_gazou_dasu_02

gosub *keion_kougeki

;――――――――――――バーの減量

mov %xtekihei_01,%bu02_hp
sub %xtekihei_01,%ko01

for %bu02_hp = %bu02_hp to %xtekihei_01 step -1
bar 3,%bu02_hp,610,587,180,5,%bu02_max,#33FF99
wait 3
print 1
if %bu02_hp < 0 : break
next

;――――――――――――

mov %bu02_hp,%xtekihei_01

if %bu02_hp < 0 : mov %bu02_hp,0

 gosub *vn_text_000036 

csp 6

if %bu02_hp < 1 : gosub *sibou_nakama_sen

csp 1 : csp 2 : csp 3 : csp 4 : csp 5

csp 550 : csp 599

;――――――――――――

return



;――――――――――――――――――――――
